{
  "name": "yunhe-vue",
  "version": "1.0.0",
  "description": "基于 NestJS、Vue3、TypeScript 构建的企业级全栈后台系统模板，专为前端开发者打造，开箱即用，快速上手全栈开发",
  "packageManager": "pnpm@11.5.2",
  "license": "MIT",
  "author": {
    "name": "当时只道是寻常",
    "email": "1207588603@qq.com"
  },
  "scripts": {
    "dev:server": "pnpm --filter server start:dev",
    "build:server": "pnpm --filter server build",
    "dev:admin": "pnpm --filter admin dev",
    "build:admin": "pnpm --filter admin build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose down && docker image prune -f && docker compose up -d --build",
    "docker:reset": "docker compose down -v && docker system prune -f && docker compose up -d --build",
    "svg:clean": "esno ./scripts/svg-clean.ts"
  },
  "dependencies": {
    "axios": "1.17.0",
    "dayjs": "1.11.21",
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "25.9.2",
    "esno": "4.8.0",
    "typescript": "6.0.3"
  }
}
